# ---- Azure OpenAI (server-side only — read by netlify/functions/coach.mjs) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_KEY=            # leave blank if using a managed identity/Entra proxy
LIFE_LAB_AI_MODE=off             # off | shadow | on

# ---- Database (Netlify DB / Neon sets this automatically when you add the integration) ----
NETLIFY_DATABASE_URL=postgres://...

# ---- Pilot configuration ----
LIFE_LAB_SCHOOL_CODE=OAKFIELD    # pseudonymous school label written on every session
LIFE_LAB_DEMO_MODE=true          # include DEMO school rows on the dashboard (switch OFF before the pilot)
LIFE_LAB_SESSION_LIMIT_MINUTES=20

# ---- Client-visible (Vite exposes only VITE_* to the browser) ----
VITE_SCHOOL_CODE=OAKFIELD
VITE_DEMO_MODE=true
